{
  "info": {
    "_postman_id": "5b3f0d2a-1a4d-4f1a-b8e0-notifyhub0001",
    "name": "NotifyHub",
    "description": "Notification microservice with priority queues, retries, idempotency and delivery-status tracking.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "health"]
        }
      }
    },
    {
      "name": "Create batch (transactional SMS)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const data = pm.response.json();",
              "pm.collectionVariables.set('lastBatchId', data.batch_id);",
              "if (data.notification_ids && data.notification_ids.length) {",
              "  pm.collectionVariables.set('lastNotificationId', data.notification_ids[0]);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json"},
          {"key": "Idempotency-Key", "value": "{{$guid}}"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"channel\": \"sms\",\n  \"priority\": \"transactional\",\n  \"message\": \"Your verification code is 4242\",\n  \"recipients\": [\"+12025550101\", \"+12025550102\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/notifications",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "notifications"]
        }
      }
    },
    {
      "name": "Create batch (marketing Email)",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"channel\": \"email\",\n  \"priority\": \"marketing\",\n  \"message\": \"Weekly newsletter\",\n  \"recipients\": [\"alice@example.com\", \"bob@example.com\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/notifications",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "notifications"]
        }
      }
    },
    {
      "name": "Get notification by id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/notifications/{{lastNotificationId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "notifications", "{{lastNotificationId}}"]
        }
      }
    },
    {
      "name": "Recipient history",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/recipients/+12025550101/notifications?limit=50",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "recipients", "+12025550101", "notifications"],
          "query": [{"key": "limit", "value": "50"}]
        }
      }
    },
    {
      "name": "Provider delivery callback",
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"notification_id\": \"{{lastNotificationId}}\",\n  \"status\": \"delivered\",\n  \"provider_message_id\": \"webhook-msg-123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/notifications/callbacks/delivery",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "notifications", "callbacks", "delivery"]
        }
      }
    }
  ],
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8000"},
    {"key": "lastBatchId", "value": ""},
    {"key": "lastNotificationId", "value": ""}
  ]
}
